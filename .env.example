NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Email delivery via Resend (resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=PrintOS <noreply@yourdomain.com>

# Optional: SMS delivery via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional: Google Maps (address autocomplete on customer forms)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: Dialpad screen pop (incoming call toast + webhook)
DIALPAD_WEBHOOK_SECRET=your_webhook_secret_here

# Optional: GoHighLevel (GHL) lead sync webhook. Required as of this commit --
# the route now fails closed if this is unset (see
# known-issues/2026-08-19-ghl-dialpad-webhook-secret-handoff.md before setting
# this in Vercel, deploying breaks the GHL integration until both sides agree
# on the same secret).
GHL_WEBHOOK_SECRET=your_webhook_secret_here
GHL_LOCATION_ID=
GHL_ORG_SLUG=quarter-mile-inc

# Required for scheduled jobs (see vercel.json "crons"): authenticates
# Vercel Cron's trigger requests to /api/cron/* routes. Vercel
# automatically sends `Authorization: Bearer <CRON_SECRET>` when this is
# set as a project env var -- generate any long random string.
CRON_SECRET=
